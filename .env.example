# 이 파일을 복사해서 .env.local을 만들고 실제 키를 채운다.
#   Windows: copy .env.example .env.local
#   macOS/Linux: cp .env.example .env.local
# .env.local은 GitHub에 올라가지 않는다. 이 파일에는 실제 키를 절대 적지 않는다.
# 값을 바꾼 뒤에는 개발 서버를 껐다가(Ctrl + C) 다시 켜야 적용된다.

# OpenAI API 키 (운영진 지원). 없으면 AI 답변 없이 "관련 기록"만 보여 준다.
OPENAI_API_KEY=

# 답변에 쓸 모델 (비워 두면 gpt-5.4-mini). 쓸 수 있는 이름은 OpenAI 가격 페이지에서 확인.
OPENAI_MODEL=

# 가상 AI 모드: 1로 두면 OpenAI를 부르지 않고 정해진 형식의 가짜 답을 만든다 (크레딧 사용 안 함)
# 실제 AI로 시험할 때는 이 줄을 지우거나 0으로 바꾼다.
MOCK_AI=

# GitHub 토큰 (Fine-grained, 공개 저장소 읽기만). 없으면 요청 한도가 시간당 약 60번.
GITHUB_TOKEN=

# Supabase (임베딩 단계부터)
SUPABASE_URL=
SUPABASE_ANON_KEY=
