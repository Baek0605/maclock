# 이 파일을 복사해서 .env.local을 만들고 실제 키를 채운다.
#   Windows: copy .env.example .env.local
#   macOS/Linux: cp .env.example .env.local
# .env.local은 GitHub에 올라가지 않는다. 이 파일에는 실제 키를 절대 적지 않는다.

# OpenAI API 키 (운영진 지원)
OPENAI_API_KEY=

# GitHub 토큰 (Fine-grained, 공개 저장소 읽기만)
GITHUB_TOKEN=

# Supabase (6단계부터)
SUPABASE_URL=
SUPABASE_ANON_KEY=
